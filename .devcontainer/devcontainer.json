{
  "name": "HostFlow Monorepo Dev Environment",
  "dockerComposeFile": [
    "../compose.yaml"
  ],
  "service": "workspace",
  "runServices": [
    "mysql",
    "redis",
    "mailpit",
    "backend",
    "frontend",
    "workspace"
  ],
  "workspaceFolder": "/workspaces/hostflow",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "customizations": {
    "vscode": {
      // Extensiones preinstaladas automáticamente DENTRO del contenedor
      "extensions": [
        // Java & Spring Boot
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot-reconciler",
        "alexcreasy.cucumber",

        // TypeScript, React & Next.js
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.js-debug-nightly",
        "ms-vscode.vscode-typescript-next",

        // Herramientas generales
        "eamodio.gitlens",
        "mhutchie.git-graph",
        "github.vscode-github-actions",

        // Cliente de bases de datos
        "cweijan.vscode-database-client2",
        "cweijan.dbclient-jdbc"
      ],
      "settings": {
        "java.configuration.updateBuildConfiguration": "automatic",
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  // Puertos que se reenviarán automáticamente
  "forwardPorts": [8080, 3000, 8025]
}
