COMPOSE_PROJECT_NAME=delta-tigre-prod
COMPOSE_PROFILES=production

# Rellena con versiones/digests aprobados y probados; no despliegues con valores vacíos.
MYSQL_IMAGE=
# <AGREGAR IMAGEN Y VERSION DE MYSQL>
REDIS_IMAGE=
# <AGREGAR IMAGEN Y VERSION DE REDIS>
MAILPIT_IMAGE=
# Mailpit solo se inicia con el perfil development; puede dejarse sin configurar en producción.
JAVA_BUILD_IMAGE=
# <AGREGAR IMAGEN JDK 21 APROBADA>
JAVA_RUNTIME_IMAGE=
# <AGREGAR IMAGEN JRE 21 APROBADA>
NODE_IMAGE=
# <AGREGAR IMAGEN NODE COMPATIBLE CON NEXT.JS>

# MySQL. Para producción usa secretos únicos y configura TLS para la conexión JDBC.
MYSQL_DATABASE=
# <AGREGAR NOMBRE DE LA BASE DE DATOS>
MYSQL_USER=
# <AGREGAR NOMBRE DE USUARIO DE BASE DE DATOS>
MYSQL_PASSWORD=
# <AGREGAR CONTRASENA SEGURA DEL USUARIO>
MYSQL_ROOT_PASSWORD=
# <AGREGAR CONTRASENA SEGURA DE ROOT>
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_JDBC_PARAMS=
# <AGREGAR PARAMETROS JDBC CON TLS, POR EJEMPLO sslMode=VERIFY_IDENTITY>

# Redis. La contraseña se aplica al servidor Redis y la usa también el backend.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=
# <AGREGAR CONTRASENA UNICA Y SEGURA PARA REDIS>

# Puertos de localhost en el host. Configura un proxy TLS delante de frontend/backend.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
MAILPIT_SMTP_HOST_PORT=
MAILPIT_UI_HOST_PORT=

# SMTP del proveedor de producción; habilita autenticación y STARTTLS según el proveedor.
SPRING_MAIL_HOST=
# <AGREGAR HOST SMTP DEL PROVEEDOR>
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
# <AGREGAR USUARIO SMTP O IDENTIDAD DEL PROVEEDOR>
SPRING_MAIL_PASSWORD=
# <AGREGAR CONTRASENA O TOKEN SMTP>
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# URL HTTPS pública de la API, accesible desde el navegador del huésped.
NEXT_PUBLIC_API_URL=
SPRING_APPLICATION_NAME=delta_tigre # <AGREGAR URL HTTPS PUBLICA DE LA API>
IP_ADDRESS=127.0.0.1 # <AGREGAR IP REAL>