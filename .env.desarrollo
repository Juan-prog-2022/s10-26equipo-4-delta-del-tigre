COMPOSE_PROJECT_NAME=s10-26equipo-4-delta-del-tigre
COMPOSE_PROFILES=development

# Imágenes de desarrollo. En producción, fija versiones exactas y, de ser posible, digests.
MYSQL_IMAGE=mysql:8.4
REDIS_IMAGE=redis:7-alpine
MAILPIT_IMAGE=axllent/mailpit:latest
JAVA_BUILD_IMAGE=eclipse-temurin:21-jdk-alpine
JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine
NODE_IMAGE=node:20-alpine

# MySQL (credenciales locales existentes; no reutilizar en producción).
MYSQL_DATABASE=mydatabase
MYSQL_USER=myuser
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=verysecret
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_JDBC_PARAMS=useSSL=false&serverTimezone=America/Argentina/Buenos_Aires&allowPublicKeyRetrieval=true

# Redis (contraseña local; no reutilizar en producción).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=redis_dev_only_change_me

# Puertos publicados en localhost.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# SMTP local: Mailpit está habilitado por COMPOSE_PROFILES=development.
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# La URL NEXT_PUBLIC_* se incorpora al bundle durante el build y la usa el navegador.
NEXT_PUBLIC_API_URL=http://localhost:8080
SPRING_APPLICATION_NAME=delta_tigre
IP_ADDRESS=127.0.0.1
